<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        BLUETOOTH permissions are commented out until this app actually talks to a real watch
        over Bluetooth (today it only logs what it captures — see NavigationAccessibilityService's
        class doc). Uncomment when BluetoothPhoneCommunication is wired to a real BluetoothProvider
        on this side, matching whatever the watch side ends up using (see the open Data-Layer-API
        question in docs/android-integration-research.md — it affects THIS app's Bluetooth code
        too, not just the watch's).

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    -->

    <application
        android:allowBackup="false"
        android:label="Dashboard Companion"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            This is the one component doing anything sensitive in this app: it reads accessibility
            events (which can include on-screen text and announcements from OTHER apps) filtered
            to just known navigation app package names. Per Google Play's Accessibility API
            policy, an app using this API for a non-accessibility purpose must:
              1. Declare this usage in the Play Console and get it reviewed.
              2. Clearly disclose in-app what's being accessed and why (see MainActivity).
              3. Only request it for a narrow, clearly explained purpose — this service ignores
                 everything except text resembling a turn-by-turn instruction (see
                 NavigationAccessibilityService + core's NavigationAnnouncementParser).
            See docs/android-integration-research.md for the sourced policy details.
        -->
        <service
            android:name=".NavigationAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
